#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"

/ {
    // ... (υπάρχοντα behaviors ή keymaps του Corne)

    macros {
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings = <&kp EQUAL>, <&kp GREATER_THAN>;
        };

        m_eq3: m_eq3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings = <&kp EQUAL>, <&kp EQUAL>, <&kp EQUAL>;
        };

        m_not_eq: m_not_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings = <&kp EXCLAMATION>, <&kp EQUAL>;
        };

        m_hi1: m_hi1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings = <&kp LESS_THAN>, <&kp M>, <&kp A>, <&kp R>, <&kp K>, <&kp GREATER_THAN>;
        };

        m_hi2: m_hi2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings = <&kp LESS_THAN>, <&kp SLASH>, <&kp M>, <&kp A>, <&kp R>, <&kp K>, <&kp GREATER_THAN>;
        };

        mas: macro_auto_shift {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_2to1>
                , <&macro_press &none MACRO_PLACEHOLDER> // Placeholder για v0.3
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_tap &none MACRO_PLACEHOLDER>
                ;
        };
    };
};

